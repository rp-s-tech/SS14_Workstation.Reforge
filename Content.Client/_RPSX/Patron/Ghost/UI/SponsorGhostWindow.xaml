<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.RPSX.Patron.Ghost.UI.SponsorGhostWindow"
               Title="{Loc 'personal-items-ghost-skins-title'}"
               Resizable="True"
               SetSize="200 300">
    <ScrollContainer Name="TreeScroll"
                     HScrollEnabled="False" VScrollEnabled="True"
                     VerticalExpand="True"
                     HorizontalExpand="True">

        <BoxContainer Name="GhostsContainer" Orientation="Vertical" SeparationOverride="4"
                      VerticalExpand="True"
                      HorizontalExpand="True" />
    </ScrollContainer>
</DefaultWindow>
